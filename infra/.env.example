# Plantilla de variables del entorno de desarrollo.
# Cópiala como infra/.env y rellena los valores. infra/.env no se sube a Git.

# Oracle: contraseña de SYS, SYSTEM y PDBADMIN.
ORACLE_PWD=

# Keycloak: administrador inicial de la consola (http://localhost:8080/admin).
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=